<?xml version="1.0" encoding="utf-8"?>
<!--
  â”Œâ”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”
  â”‚  ABDM Integration â€“ Web.config                                          â”‚
  â”‚                                                                         â”‚
  â”‚  Replace the placeholder values with your actual ABDM sandbox/prod      â”‚
  â”‚  credentials before running.  Never commit real secrets to source       â”‚
  â”‚  control; use Azure Key Vault, AWS Secrets Manager, or environment      â”‚
  â”‚  variables in production.                                               â”‚
  â””â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”˜
-->
<configuration>

  <appSettings>

    <!-- â”€â”€ Auth endpoint (full URL including path) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <!-- Sandbox:    https://dev.abdm.gov.in/gateway/v0.5/sessions           -->
    <!-- Production: https://apis.abdm.gov.in/api/hiecm/gateway/v3/sessions  -->
    <add key="ABDM_AUTH_URL"      value="https://dev.abdm.gov.in/gateway/v0.5/sessions" />

    <!-- â”€â”€ ABDM Gateway base (kept for other gateway calls) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <add key="ABDM_BASE_URL"      value="https://dev.abdm.gov.in/gateway" />

    <!-- Credentials issued in the ABDM sandbox/production portal           -->
    <add key="ABDM_CLIENT_ID"     value="YOUR_CLIENT_ID" />
    <add key="ABDM_CLIENT_SECRET" value="YOUR_CLIENT_SECRET" />

    <!-- â”€â”€ ABHA API (Module 1 â€“ Health ID creation / lookup) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <!-- Sandbox: https://healthidsbx.abdm.gov.in/api                       -->
    <!-- Production: https://healthid.abdm.gov.in/api                       -->
    <add key="ABDM_ABHA_BASE_URL" value="https://abhasbx.abdm.gov.in/abha/api" />

    <!-- â”€â”€ HFR API (Module 2 â€“ Health Facility Registry) â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€â”€ -->
    <!-- Sandbox: https://facilitysbx.abdm.gov.in                          -->
    <!-- Production: https://facility.abdm.gov.in                           -->
    <add key="ABDM_HFR_BASE_URL"  value="https://facilitysbx.abdm.gov.in" />

    <!-- â”€â”€ HIU Callback base URL (Module 3 â€“ where ABDM POSTs back) â”€â”€â”€â”€â”€ -->
    <!-- Must be publicly reachable HTTPS; use ngrok during local dev       -->
    <!-- Example: https://abc123.ngrok.io  or  https://yourdomain.com       -->
    <add key="ABDM_HIU_CALLBACK_BASE" value="https://your-public-url.example.com" />

    <!-- CM-ID: "sbx" for sandbox; your registered CM-ID for production     -->
    <add key="ABDM_CM_ID"         value="sbx" />

  </appSettings>

  <system.web>
    <hostingEnvironment shadowCopyBinAssemblies="false" />
    <compilation debug="true" targetFramework="4.8" />
    <httpRuntime targetFramework="4.8" executionTimeout="120" />
    <customErrors mode="Off" />
    <trace writeToDiagnosticsTrace="true" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <modules runAllManagedModulesForAllRequests="true" />
    <handlers>
      <remove name="ExtensionlessUrlHandler-Integrated-4.0" />
      <remove name="OPTIONSVerbHandler" />
      <remove name="TRACEVerbHandler" />
      <add name="ExtensionlessUrlHandler-Integrated-4.0" path="*." verb="*"
           type="System.Web.Handlers.TransferRequestHandler"
           preCondition="integratedMode,runtimeVersionv4.0" />
    </handlers>
  </system.webServer>

  <runtime>
    <assemblyBinding xmlns="urn:schemas-microsoft-com:asm.v1">
<dependentAssembly>
        <assemblyIdentity name="System.Web.Mvc" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-5.3.0.0" newVersion="5.3.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.WebPages" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="System.Web.Helpers" publicKeyToken="31bf3856ad364e35" />
        <bindingRedirect oldVersion="0.0.0.0-3.0.0.0" newVersion="3.0.0.0" />
      </dependentAssembly>
      <dependentAssembly>
        <assemblyIdentity name="Newtonsoft.Json" publicKeyToken="30ad4fe6b2a6aeed" />
        <bindingRedirect oldVersion="0.0.0.0-13.0.0.0" newVersion="13.0.0.0" />
      </dependentAssembly>
    </assemblyBinding>
  </runtime>

  <!--
    Increase connection pool for HttpClient calls to ABDM APIs.
    The default of 2 connections per host causes serious throttling.
  -->
  <system.net>
    <connectionManagement>
      <add address="*" maxconnection="50" />
    </connectionManagement>
  </system.net>

</configuration>
