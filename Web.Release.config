<?xml version="1.0" encoding="utf-8"?>
<!--
  Web.Release.config - Production transform applied during publish (Release build).

  This file is NOT deployed directly. Visual Studio merges it with Web.config
  using XDT (XML Document Transform) syntax before deploying.

  All production URLs verified against live ABDM endpoints.

  Before going live:
    1. Replace ABDM_CLIENT_ID and ABDM_CLIENT_SECRET with production values.
    2. Replace ABDM_HIU_CALLBACK_BASE with your publicly reachable HTTPS domain.
    3. Replace ABDM_CM_ID with your registered production CM-ID (issued by NHA).
    4. Never commit production secrets - use environment variables or
       Azure Key Vault / AWS Secrets Manager to inject at deploy time.
-->
<configuration xmlns:xdt="http://schemas.microsoft.com/XML-Document-Transform">

  <appSettings>

    <!-- Auth endpoint: v0.5 sandbox -> v3 production (verified: 403 = exists) -->
    <add key="ABDM_AUTH_URL"
         value="https://apis.abdm.gov.in/api/hiecm/gateway/v3/sessions"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- Gateway base: sandbox -> production -->
    <add key="ABDM_BASE_URL"
         value="https://apis.abdm.gov.in/api/hiecm/gateway"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- Production credentials (replace with actual values) -->
    <add key="ABDM_CLIENT_ID"
         value="YOUR_PRODUCTION_CLIENT_ID"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <add key="ABDM_CLIENT_SECRET"
         value="YOUR_PRODUCTION_CLIENT_SECRET"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- ABHA v3 API: sandbox -> production (verified: 401 = exists) -->
    <add key="ABDM_ABHA_BASE_URL"
         value="https://abha.abdm.gov.in/api/abha"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- HFR API: sandbox -> production (verified: 200 OK) -->
    <add key="ABDM_HFR_BASE_URL"
         value="https://facility.abdm.gov.in"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- HIU Callback: replace with your production HTTPS domain -->
    <add key="ABDM_HIU_CALLBACK_BASE"
         value="https://YOUR_PRODUCTION_DOMAIN.com"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

    <!-- CM-ID: sbx -> your registered production CM-ID -->
    <add key="ABDM_CM_ID"
         value="YOUR_PRODUCTION_CM_ID"
         xdt:Transform="SetAttributes"
         xdt:Locator="Match(key)" />

  </appSettings>

  <system.web>
    <!-- Disable debug compilation in production -->
    <compilation xdt:Transform="RemoveAttributes(debug)" />
    <!-- Tighter timeout for production -->
    <httpRuntime executionTimeout="30" xdt:Transform="SetAttributes" />
    <!-- Remove trace output -->
    <trace xdt:Transform="Remove" />
  </system.web>

  <system.webServer>
    <validation validateIntegratedModeConfiguration="false" />
    <!-- Security headers for production -->
    <httpProtocol xdt:Transform="Insert">
      <customHeaders>
        <add name="X-Content-Type-Options" value="nosniff" />
        <add name="X-Frame-Options"        value="DENY" />
        <add name="X-XSS-Protection"       value="1; mode=block" />
        <add name="Referrer-Policy"        value="strict-origin-when-cross-origin" />
      </customHeaders>
    </httpProtocol>
  </system.webServer>

</configuration>
